pipeline {
    agent {
        docker {
            image 'mcr.microsoft.com/dotnet/sdk:10.0'
        }
    }
    
    stages {
        stage('Build') {
            steps {
                echo 'Building...'
                sh 'dotnet build JenkinsBlazor.sln --configuration Release'
            }
        }//end stage Build
        stage('Test') {
            steps {
                echo 'Testing...'
                //Add your test commands here
            }
        }//end stage Test
        stage('Deploy') {
            steps {
                echo 'Deploying'
                //Add your deploy commands here
            }
        }//end stage Deploy
    } //end stages
    post {
        success {
            echo 'Pipeline ejecutado con éxito'
        }
        failure {
            echo 'Pipeline fallido'
        }
    }
} //end pipeline
